ENV=local

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=chatfolio
DATABASE_PASSWORD=chatfolio
DATABASE_NAME=chatfolio

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Storage (S3/MinIO) ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=chatfolio-cv
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_MAX_CV_UPLOAD_MB=20

# --- Security ---
# >=32 bytes so PyJWT doesn't warn about a weak HMAC key even locally. This exact value is
# refused outside a `local` ENV by create_app() — generate a real random secret for anything
# that isn't a laptop, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SECURITY_JWT_SECRET=change-me-in-env-generate-a-real-random-secret-please
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=30
SECURITY_CORS_ORIGINS=["http://localhost:3000"]
SECURITY_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SECURITY_TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
SECURITY_OTP_TTL_MINUTES=10
SECURITY_OTP_MAX_ATTEMPTS=5
SECURITY_GOOGLE_OAUTH_STATE_TTL_MINUTES=10
# Fernet key backing the encrypted-at-rest Google refresh/access tokens (meeting-settings
# integration). Reversible by design, unlike SECURITY_JWT_SECRET — generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# This exact value is refused outside a `local` ENV by create_app(), same guard as the JWT secret.
SECURITY_TOKEN_ENCRYPTION_KEY=change-me-in-env-generate-with-fernet-generate-key

# --- Vector store ---
# Host port must match docker-compose.yml's chroma service mapping, not chromadb's own default
# (8000) — check `docker compose ps` if this ever needs changing, especially if another
# project's own Chroma/other container happens to already be using a given host port.
VECTORSTORE_PROVIDER=chroma
VECTORSTORE_HOST=localhost
VECTORSTORE_PORT=8004

# --- LLM ---
# The default provider answers every task (and is the model free users get and the fallback when
# a premium user's chosen model fails). deepseek | openai | gemini — each needs its API key and
# model below. Per-task overrides are optional.
LLM_DEFAULT_PROVIDER=deepseek
# LLM_PROVIDER_FOR_EXTRACTION=
# LLM_PROVIDER_FOR_GENERATION=
# LLM_PROVIDER_FOR_INTENT=
# LLM_PROVIDER_FOR_CHAT=
# LLM_PROVIDER_FOR_EMBEDDING=

# API keys. A provider without a key is never used: premium users' choices of its models show as
# unavailable and fall back to the default. Anthropic/Grok/OpenRouter have no adapter yet.
LLM_DEEPSEEK_API_KEY=
LLM_OPENAI_API_KEY=
LLM_GEMINI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GROK_API_KEY=
LLM_OPENROUTER_API_KEY=

# API roots (OpenAI-compatible `/chat/completions`). These are the defaults — set them only to
# point at a proxy/gateway, a regional endpoint or a mock server. A trailing slash is optional.
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model each provider uses when it is the env-selected one (the default above, or a per-task
# override): intent classification, CV extraction, the free-tier model and the fallback. Set the
# one for whichever provider you pick as default — OpenAI/Gemini have no built-in default because
# model ids change. Extra models premium users can choose between are added in the admin panel.
LLM_DEEPSEEK_MODEL=deepseek-chat
# LLM_OPENAI_MODEL=
# LLM_GEMINI_MODEL=

LLM_RETRIEVAL_SIMILARITY_THRESHOLD=0.25
# Optional: absolute path to a chat_prompts.toml to use instead of the bundled one, so the chat
# assistant's tone/rules can be tuned without a code change or rebuild. Leave unset to use the
# bundled default at src/chatfolio/llm/prompts/chat_prompts.toml.
# LLM_PROMPTS_CONFIG_PATH=

# --- App links ---
# Used only to build the reset-password link inside outbound emails.
APP_FRONTEND_BASE_URL=http://localhost:3000

# --- Google OAuth (meeting-settings: Calendar connect flow) ---
# From a Google Cloud Console OAuth client (Web application type). GOOGLE_REDIRECT_URI must
# byte-for-byte match an "Authorized redirect URI" registered there — Google rejects the token
# exchange otherwise. Left unset = the connect endpoint responds 503 instead of failing
# obscurely, same "log and skip"-style safe default as Email/SMS above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/meeting-settings/google/callback

# --- Email (forgot-password link, 2FA email codes) ---
# Left unset = EmailSender logs and skips instead of sending, safe default for local/tests.
# Set every value below to actually deliver mail (e.g. Gmail app password, SES/Mailgun SMTP).
# EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@chatfolio.example.com

# --- SMS (welcome SMS, 2FA codes, meeting alerts) ---
# Gateway: POST {SMS_API_URL} with X-Client-Id / X-Client-Password headers. Any left unset =
# SmsSender logs and skips, same safe default as email. Message text lives in
# src/chatfolio/notifications/sms_templates.toml.
# SMS_API_URL=http://localhost:8007/sms/send
# SMS_CLIENT_ID=
# SMS_CLIENT_PASSWORD=

# --- Support Kori (plan purchases via license key) ---
# Support Kori sells Chatfolio and settles the payment itself; the buyer gets a license key and
# enters it in the CMS, where we validate it against their API. A valid license = payment done.
# SUPPORT_KORI_PRODUCT_ID is required for activation to work (a plan can override it with its own
# product reference in the admin panel, e.g. one Kori product per duration).
# SUPPORT_KORI_PRODUCT_ID=
SUPPORT_KORI_VERIFY_URL=https://supportkori.com/api/licenses/verify
SUPPORT_KORI_TIMEOUT_SECONDS=10
# Live licenses are re-checked with Support Kori at most this often to catch refunds.
SUPPORT_KORI_REVALIDATE_AFTER_DAYS=7
# Wrong/unknown keys one account may submit per hour before activation pauses for it.
SUPPORT_KORI_MAX_FAILED_ATTEMPTS_PER_HOUR=10

# --- Feature flags (Phase 2 readiness) ---
FEATURE_ENABLE_CUSTOM_DOMAINS=false
FEATURE_ENABLE_BILLING=false

# --- Observability ---
# Sentry stays off (no DSN = no-op init, no network calls) until you set a real DSN in
# staging/production. /metrics (Prometheus) is on by default — flip off if you don't scrape it.
# OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_TRACES_SAMPLE_RATE=0.0
OBSERVABILITY_METRICS_ENABLED=true

# --- Test isolation ---
# tests/conftest.py forces DATABASE_NAME, STORAGE_BUCKET, and REDIS_DB to these before the app
# is imported, regardless of the values set above — pytest must never touch dev data, dev
# uploaded files, or jobs queued for the dev worker. Override only if you need different test
# resource names (e.g. parallel CI runners).
# TEST_DATABASE_NAME=chatfolio_test
# TEST_STORAGE_BUCKET=chatfolio-cv-test
# TEST_REDIS_DB=1
